# Autonomous AI Content Operations Engine
# Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES. NEVER COMMIT .env TO GIT!

# Mode: development | production | test
ENVIRONMENT=production

# Simulation Mode: true (runs full pipeline without consuming credits or publishing)
SIMULATION=false

# Dry Run Mode: true (simulates publishing, validates all assets and metadata)
DRY_RUN=false

# Browser Configuration
BROWSER_TYPE=brave
BROWSER_EXECUTABLE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
BROWSER_USER_DATA_DIR=C:\Users\user\AppData\Local\BraveSoftware\Brave-Browser\User Data
BROWSER_HEADLESS=true
BROWSER_REMOTE_DEBUGGING_PORT=9222

# System Paths (Relative to project root or absolute)
DATA_DIR=./data
DATABASE_PATH=./data/content_engine.db
LOGS_DIR=./logs

# YouTube API Credentials
YOUTUBE_CLIENT_SECRETS_FILE=./config/client_secrets.json
YOUTUBE_TOKEN_PICKLE_PATH=./config/token.pickle
YOUTUBE_CHANNEL_ID=UCULzzCCm0Y-ZHiYF480ioLg

# TikTok Configuration
TIKTOK_ENABLED=true
TIKTOK_CREATOR_REWARDS_MIN_DURATION=60

# Concurrency Controls
MAX_CONCURRENT_FLOW_ACCOUNTS=3
MAX_CONCURRENT_DOWNLOADS=2
RENDER_POLL_INTERVAL_SECONDS=4
RENDER_TIMEOUT_SECONDS=100

# Security and Policy
CHILDREN_CONTENT_COMPLIANCE=true
AUTO_APPROVE_SAFE_ACTIONS_ONLY=true
REQUIRE_HUMAN_APPROVAL_FINANCIAL=true
REQUIRE_HUMAN_APPROVAL_DELETION=true
SIMILARITY_REJECTION_THRESHOLD=0.85
